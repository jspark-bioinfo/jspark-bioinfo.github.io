// Generated by build.py from data/cv.yaml. Do not edit by hand.
#let accent = rgb("#1f5f5b")
#let muted = rgb("#5b6470")
#set document(title: "{{ cv.name }} – Curriculum Vitae", author: "{{ cv.name }}")
#set page(
  paper: "a4",
  margin: (x: 2cm, top: 1.8cm, bottom: 1.8cm),
  footer: context [
    #set text(8pt, fill: muted)
    {{ cv.name|t }} — Curriculum Vitae
    #h(1fr) Updated {{ updated|t }}
    #h(1fr) #counter(page).display("1 / 1", both: true)
  ],
)
#set text(font: ("Libertinus Serif", "New Computer Modern"), size: 10pt, lang: "en", region: "gb")
#set par(justify: false, leading: 0.58em, spacing: 0.75em)
#show link: set text(fill: accent)

#let section(title) = {
  v(0.9em)
  block(below: 0.55em, sticky: true)[
    #text(11.5pt, weight: "semibold", fill: accent, tracking: 0.04em)[#smallcaps(title)]
    #v(-0.65em)
    #line(length: 100%, stroke: 0.6pt + accent.lighten(40%))
  ]
}
#let sub(title) = block(above: 0.8em, below: 0.45em, sticky: true, text(weight: "bold", size: 10.4pt, title))
#let entry(date, body) = block(breakable: true, above: 0.55em, below: 0.55em, grid(
  columns: (2.55cm, 1fr), column-gutter: 0.4cm,
  text(fill: muted, size: 9.4pt, date), body,
))
#let note(body) = text(fill: muted, size: 9.4pt, body)
#let bullets(..items) = pad(top: 0.15em, list(marker: text(fill: accent)[–], indent: 0pt, body-indent: 0.5em, spacing: 0.4em, ..items))
#let pub(n, body) = block(above: 0.55em, below: 0.55em, grid(columns: (0.6cm, 1fr), text(fill: muted, size: 9.4pt)[#n.], body))

// ───────────── Header ─────────────
#grid(
  columns: (1fr, auto), align: (left + bottom, right + bottom),
  [
    #text(24pt, weight: "regular", tracking: 0.01em)[{{ cv.name|t }}]
    #v(-0.4em)
    #text(11pt, fill: muted)[{{ cv.title|t }}, {{ cv.affiliation|t }}]
  ],
  text(9pt, fill: muted)[
    #link("mailto:{{ cv.email }}")[{{ cv.email|t }}] \
    #link("https://jspark-bioinfo.github.io")[jspark\-bioinfo.github.io] \
    {% for l in cv.links if l.label != "GitHub" %}#link("{{ l.url }}")[{{ l.label|t }}]{% if not loop.last %} · {% endif %}{% endfor %}

  ],
)
#v(0.2em)
#line(length: 100%, stroke: 1.2pt + accent)

#section("Profile")
#par(justify: true)[{{ cv.profile|t }}]

#v(0.3em)
#note[*Research areas:* {{ cv.research_fields|map("t")|join(" · ") }}]

#section("Employment")
{% for x in cv.experience %}
#entry("{{ x.years }}")[
  #strong[{{ x.role|t }}], {{ x.org|t }} \
  #note[Supervisor: {{ x.supervisor|t }}]
  #bullets({% for b in x.bullets %}[{{ b|t }}],{% endfor %})
]
{% endfor %}

#section("Education")
{% for e in cv.education %}
#entry("{{ e.years }}")[
  #strong[{{ e.degree|t }}], {{ e.institution|t }}
  {% if e.thesis %}\ #note[Thesis: #emph[{{ e.thesis|t }}]{% if e.advisor %} · Advisor: {{ e.advisor|t }}{% endif %}]{% endif %}

  {% if e.bullets %}#bullets({% for b in e.bullets %}[{{ b|t }}],{% endfor %}){% endif %}

]
{% endfor %}

#section("Publications")
#note[#strong[J Park] = this author · \* co-first author]
#sub[Journal articles]
{% for p in cv.publications.journal %}
#pub({{ loop.index }})[
  #strong[{{ p.title|t }}] \
  {{ p.authors|authors }} ({{ p.year }}). #emph[{{ p.venue|t }}]{% if p.details %} {{ p.details|t }}{% endif %}.{% if p.type == "review" %} (Review){% endif %}
  {% if p.doi %} #link("https://doi.org/{{ p.doi }}")[doi:{{ p.doi|t }}]{% elif p.url %} #link("{{ p.url }}")[{{ p.url|t }}]{% endif %}

  {% if p.note %}\ #note[{{ p.note|t }}]{% endif %}

]
{% endfor %}
#sub[Conference papers]
{% for p in cv.publications.conference %}
#pub({{ loop.index }})[
  #strong[{{ p.title|t }}] \
  {{ p.authors|authors }} ({{ p.year }}). #emph[{{ p.venue|t }}] ({{ p.kind|lower }}).
]
{% endfor %}
#sub[Patents]
{% for p in cv.publications.patents %}
#pub({{ loop.index }})[
  #strong[{{ p.title|t }}] \
  {{ p.authors|authors }} ({{ p.year }}). {{ p.number|t }} ({{ p.status|lower }}).
]
{% endfor %}
#sub[Software]
{% for s in cv.software %}
#pub({{ loop.index }})[#strong[{{ s.name|t }}] — {{ s.description|t }} #link("{{ s.url }}")[{{ s.url|replace("https://","")|t }}]]
{% endfor %}

#section("Research Projects and Funding")
{% for f in cv.funding %}
#entry("{{ f.years }}")[
  #strong[{{ f.name|t }}] \
  {{ f.description|t }} \
  #text(fill: accent)[Role: {{ f.role|t }}]
  #bullets({% for b in f.bullets %}[{{ b|t }}],{% endfor %})
]
{% endfor %}

#section("Supervision")
#text(weight: "semibold")[{{ cv.supervision.overview|t }}]
#sub[Co-supervised PhD students]
{% for s in cv.supervision.phd %}
#entry("{{ s.years }}")[#emph[{{ s.name|t }}], {{ s.institution|t }} \ #note[{{ s.topic|t }}]]
{% endfor %}
#sub[Supervised master's students]
{% for s in cv.supervision.masters %}
#entry("{{ s.years }}")[#emph[{{ s.name|t }}], {{ s.institution|t }}{% if s.note %} · {{ s.note|t }}{% endif %} \ #note[{{ s.topic|t }}]]
{% endfor %}
#sub[Supervised undergraduate interns (selected)]
#note[Common project: #emph[{{ cv.supervision.interns.common_topic|t }}]]
{% for s in cv.supervision.interns.list %}
#entry("{{ s.years }}")[#emph[{{ s.name|t }}], {{ s.institution|t }} · {{ s.topic|t }}{% if s.note %} · #note[{{ s.note|t }}]{% endif %}]
{% endfor %}

#section("Invited Talks")
{% for k in cv.talks %}
#entry("{{ k.year }}")[
  #strong[{{ k.title|t }}] \
  {{ k.role|t }}, {{ k.event|t }}, {{ k.place|t }}, {{ k.date|t }}.
]
{% endfor %}

#section("Academic Service")
{% for s in cv.service %}
#entry("{{ s.years }}")[
  #strong[{{ s.name|t }}] — {{ s.role|t }} \
  #note[{{ s.description|t }}]
]
{% endfor %}

#section("Affiliations")
{% for s in cv.affiliations %}
#entry("{{ s.years }}")[
  #strong[{{ s.name|t }}] — {{ s.role|t }}
]
{% endfor %}

#section("Awards and Languages")
{% for a in cv.awards %}
#entry("{{ a.years }}")[{{ a.name|t }}]
{% endfor %}
#entry("")[{% for l in cv.languages %}{{ l.name|t }} ({{ l.level|lower|t }}){% if not loop.last %} · {% endif %}{% endfor %}]
