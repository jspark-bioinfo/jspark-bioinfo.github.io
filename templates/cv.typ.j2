// Generated by build.py from data/cv.yaml. Do not edit by hand.
#let accent = rgb("#1f5f5b")
#let ink = rgb("#1b1f23")
#let muted = rgb("#6b737c")
#let hair = rgb("#e3e6e8")
#let labelw = 3.1cm

#set document(title: "{{ cv.name }} – Curriculum Vitae", author: "{{ cv.name }}")
#set page(
  paper: "a4",
  margin: (left: 1.7cm, right: 1.7cm, top: 1.6cm, bottom: 1.6cm),
  footer: context {
    set text(7.5pt, fill: muted, tracking: 0.02em)
    grid(columns: (1fr, auto),
      [{{ cv.name|t }} · Curriculum Vitae · Updated {{ updated|t }}],
      counter(page).display("1 / 1", both: true))
  },
)
#set text(font: "Inter", size: 9pt, fill: ink, lang: "en", region: "gb", number-type: "lining")
#set par(justify: false, leading: 0.62em, spacing: 0.9em)
#show link: set text(fill: accent)
#show strong: it => text(weight: "semibold", it.body)

// ── building blocks ─────────────────────────────────────────
#let section(title, body) = block(above: 1.35em, below: 0pt, breakable: true)[
  #grid(columns: (labelw, 1fr), column-gutter: 0pt,
    block(sticky: true, text(7.6pt, weight: "semibold", fill: accent, tracking: 0.14em, upper(title))),
    block(breakable: true, body),
  )
]
#let entry(title, date: none, sub: none, body: none) = block(above: 0.85em, below: 0pt, breakable: true)[
  #grid(columns: (1fr, auto), column-gutter: 1em,
    text(weight: "semibold", title),
    if date != none { text(8pt, fill: muted, date) },
  )
  #if sub != none { v(-0.45em); text(8.4pt, fill: muted, sub) }
  #if body != none { v(-0.3em); body }
]
#let bullets(..items) = list(marker: text(fill: accent, "•"), indent: 0pt, body-indent: 0.55em, spacing: 0.5em, ..items.pos().map(i => text(8.6pt, i)))
#let tag(s, strong: false) = box(
  inset: (x: 4pt, y: 1.6pt), radius: 6pt, baseline: 1.4pt,
  fill: if strong { accent } else { accent.lighten(88%) },
  text(6.6pt, weight: "semibold", tracking: 0.04em, fill: if strong { white } else { accent }, upper(s)),
)
#let pub(n, body) = block(above: 0.8em, below: 0pt, grid(columns: (0.55cm, 1fr),
  text(8pt, fill: muted, str(n)), body))
#let subhead(s) = block(above: 1.0em, below: 0pt, sticky: true, text(8pt, weight: "semibold", fill: muted, tracking: 0.06em, upper(s)))

// ── header ──────────────────────────────────────────────────
#grid(columns: (1fr, auto), align: (left + bottom, right + bottom),
  [
    #text(font: "Inter Display", 27pt, weight: "semibold", tracking: -0.01em)[{{ cv.name|t }}]
    #v(-0.7em)
    #text(10pt, fill: muted)[{{ cv.title|t }} · {{ cv.affiliation|t }}]
  ],
  text(8pt, fill: muted, align(right)[
    #link("mailto:{{ cv.email }}")[{{ cv.email|t }}] \
    #link("https://jspark-bioinfo.github.io")[jspark\-bioinfo.github.io] \
    {% for l in cv.links if l.label != "GitHub" %}#link("{{ l.url }}")[{{ l.label|t }}]{% if not loop.last %} · {% endif %}{% endfor %}

  ]),
)
#v(0.6em)
#line(length: 100%, stroke: 0.5pt + hair)
#v(0.2em)
#grid(columns: (labelw, 1fr),
  [],
  [
    #text(11.5pt, weight: "medium", fill: accent)[{{ cv.tagline|t }}]
    #v(0.1em)
    #par(justify: true)[{{ cv.profile|t }}]
    #par(justify: true)[{{ cv.profile2|t }}]
    #v(0.2em)
    {% for f in cv.research_fields %}#tag("{{ f }}") {% endfor %}

  ],
)

// ── employment ─────────────────────────────────────────────
#section("Employment")[
{% for x in cv.experience %}
  #entry([{{ x.role|t }}], date: [{{ x.years|t }}], sub: [{{ x.org|t }} · Supervisor: {{ x.supervisor|t }}],
    body: bullets({% for b in x.bullets %}[{{ b|t }}],{% endfor %}))
{% endfor %}
]

#section("Education")[
{% for e in cv.education %}
  #entry([{{ e.degree|t }}], date: [{{ e.years|t }}], sub: [{{ e.institution|t }}{% if e.advisor %} · Advisor: {{ e.advisor|t }}{% endif %}],
    body: [{% if e.thesis %}#text(8.6pt)[Thesis: #emph[{{ e.thesis|t }}]]{% endif %}{% if e.bullets %}#bullets({% for b in e.bullets %}[{{ b|t }}],{% endfor %}){% endif %}])
{% endfor %}
]

#section("Publications")[
  #text(8pt, fill: muted)[#strong[J Park] = this author · \* = co-first author]
  #subhead[Journal articles]
{% for p in cv.publications.journal %}
  #pub({{ loop.index }})[
    #strong[{{ p.title|t }}] \
    #text(8.6pt)[{{ p.authors|authors }}] \
    #text(8.6pt)[#emph[{{ p.venue|t }}]{% if p.details %} {{ p.details|t }}{% endif %} ({{ p.year }}){% if p.doi %} · #link("https://doi.org/{{ p.doi }}")[doi:{{ p.doi|t }}]{% elif p.url %} · #link("{{ p.url }}")[{{ p.url|replace("https://","")|t }}]{% endif %}]
    {% if p is first_author %}#tag("first author", strong: true) {% endif %}{% if p.cofirst %}#tag("co-first", strong: true) {% endif %}{% if p.type == "review" %}#tag("review") {% endif %}{% if p.status == "preprint" %}#tag("preprint") {% endif %}

    {% if p.note %}#text(8pt, fill: muted)[{{ p.note|t }}]{% endif %}

  ]
{% endfor %}
  #subhead[Conference papers]
{% for p in cv.publications.conference %}
  #pub({{ loop.index }})[
    #strong[{{ p.title|t }}] \
    #text(8.6pt)[{{ p.authors|authors }}] \
    #text(8.6pt)[#emph[{{ p.venue|t }}] ({{ p.year }})] #tag("{{ p.kind }}")
  ]
{% endfor %}
  #subhead[Patents]
{% for p in cv.publications.patents %}
  #pub({{ loop.index }})[
    #strong[{{ p.title|t }}] \
    #text(8.6pt)[{{ p.authors|authors }} · {{ p.number|t }} ({{ p.year }})] #tag("{{ p.status }}")
  ]
{% endfor %}
]

#section("Projects & Funding")[
{% for f in cv.funding %}
  #entry([{{ f.name|t }}], date: [{{ f.years|t }}], sub: [{{ f.role|t }}],
    body: [#text(8.6pt)[{{ f.description|t }}] #bullets({% for b in f.bullets %}[{{ b|t }}],{% endfor %})])
{% endfor %}
]

#section("Supervision")[
  #text(8.6pt)[{{ cv.supervision.overview|t }}]
  #subhead[Co-supervised PhD students]
{% for s in cv.supervision.phd %}
  #entry([{{ s.name|t }}], date: [{{ s.years|t }}], sub: [{{ s.institution|t }} · {{ s.topic|t }}])
{% endfor %}
  #subhead[Master's students]
{% for s in cv.supervision.masters %}
  #entry([{{ s.name|t }}{% if s.note %} #h(0.3em) #tag("{{ s.note }}"){% endif %}], date: [{{ s.years|t }}], sub: [{{ s.institution|t }} · {{ s.topic|t }}])
{% endfor %}
  #subhead[Undergraduate interns (selected)]
  #block(above: 0.7em)[#text(8.4pt, fill: muted)[Common project: #emph[{{ cv.supervision.interns.common_topic|t }}]]]
  #block(above: 0.6em)[#text(8.6pt)[{% for s in cv.supervision.interns.list %}#strong[{{ s.name|t }}] ({{ s.institution|t }}, {{ s.years }}){% if s.note %} — {{ s.note|t }}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}]]
]

#section("Invited Talks")[
{% for k in cv.talks %}
  #entry([{{ k.title|t }}], date: [{{ k.date|t }}], sub: [{{ k.role|t }} · {{ k.event|t }} · {{ k.place|t }}])
{% endfor %}
]

#section("Service & Affiliations")[
{% for s in cv.service + cv.affiliations %}
  #entry([{{ s.name|t }}], date: [{{ s.years|t }}], sub: [{{ s.role|t }}])
{% endfor %}
]

#section("Awards")[
{% for a in cv.awards %}
  #entry([{{ a.name|t }}], date: [{{ a.years|t }}])
{% endfor %}
]

#section("Languages")[
  #block(above: 0.85em)[{% for l in cv.languages %}{{ l.name|t }} #text(fill: muted)[({{ l.level|lower|t }})]{% if not loop.last %} · {% endif %}{% endfor %}]
]
